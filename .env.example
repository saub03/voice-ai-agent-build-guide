# voice AI agent 템플릿 환경변수 예시 — 프로젝트 루트에 .env 로 복사해 쓰세요.

# [REAL · 선택] 실물 LLM (Ollama 모델명)
# AIGC_LLM_MODEL=qwen2.5:32b

# [REAL · 선택] 실물 ASR (mlx-whisper 허깅페이스 저장소명)
# AIGC_ASR_MODEL=mlx-community/whisper-large-v3-turbo

# [REAL · 선택] 실물 TTS (sherpa-onnx Supertonic 모델 디렉터리명, GitHub release)
# AIGC_TTS_SUPERTONIC=sherpa-onnx-supertonic-3-tts-int8-2026-05-11

# 4단계 서버 포트 / 세션 TTL(초)
# AIGC_PORT=8000
# AIGC_SESSION_TTL=1800
